<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Conteneur partagé avec l'extension widget (elle, obligatoirement
         sandboxée) : l'app y écrit un instantané, le widget le relit.
         Le préfixe Team ID est requis par macOS. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>KFLACS69T9.fr.lauriat.ZendureMonitor</string>
    </array>
</dict>
</plist>
