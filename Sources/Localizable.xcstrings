      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Representation" } } }
    },
    "Pertes \u0026 conversion" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Losses \u0026 conversion" } } }
    },
    "Source : Open-Meteo, rafraîchie toutes les 30 min." : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Source: Open-Meteo, refreshed every 30 min." } } }
    },
    "soutirage direct : non mesuré" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "direct draw: not measured" } } }
    },
    "Vu du dessus : centre = zénith, cercle = horizon." : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Seen from above: centre = zenith, circle = horizon." } } }
    },
    "Vu du dessus : centre = zénith, cercle = horizon. Les boucles marquent 25° et 50° d'écart d'incidence autour de chaque champ — plus le soleil est près du centre d'une boucle, plus ce champ capte." : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Seen from above: centre = zenith, circle = horizon. The loops mark 25° and 50° of incidence gap around each array — the closer the sun is to a loop's centre, the more that array captures." } } }
    },
