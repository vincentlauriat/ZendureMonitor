    "Renseignez votre position (latitude/longitude) dans Réglages → Général pour afficher les éphémérides du soleil." : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set your position (latitude/longitude) in Settings → General to display sun ephemerides." } } }
    },
